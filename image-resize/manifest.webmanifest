{
  "name": "画像を小さく",
  "short_name": "画像を小さく",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#f1f3f6",
  "theme_color": "#0d7fa8",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/gif": [
          ".gif"
        ],
        "image/bmp": [
          ".bmp"
        ]
      }
    }
  ]
}
