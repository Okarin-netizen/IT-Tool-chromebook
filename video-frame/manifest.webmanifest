{
  "name": "動画から写真",
  "short_name": "動画から写真",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#f1f3f6",
  "theme_color": "#0f766e",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "video/mp4": [".mp4", ".m4v"],
        "video/webm": [".webm"],
        "video/quicktime": [".mov"]
      }
    }
  ]
}
