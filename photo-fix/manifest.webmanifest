{
  "name": "写真を直す",
  "short_name": "写真を直す",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#f1f3f6",
  "theme_color": "#b8650f",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"],
        "image/gif": [".gif"],
        "image/bmp": [".bmp"],
        "image/heic": [".heic"],
        "image/heif": [".heif"]
      }
    }
  ]
}
