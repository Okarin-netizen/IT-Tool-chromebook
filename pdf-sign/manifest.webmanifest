{
  "name": "PDFに手書き・署名",
  "short_name": "PDF署名",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#f1f3f6",
  "theme_color": "#bd3b58",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ]
}
